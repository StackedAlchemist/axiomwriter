rules_version = '2';

// Firebase Storage rules for Axiomwriter.
// Paths in use:
//   maps/{projectId}/{mapId}/background       — procedural/imported map art
//   maps/{projectId}/{mapId}/terrain          — painted terrain layer
//   character-photos/{projectId}/{characterId} — character portrait uploads
// Ownership can't be checked against the named Firestore DB from Storage
// rules, so writes require auth plus image content-type and a size cap.
service firebase.storage {
  match /b/{bucket}/o {
    match /maps/{projectId}/{mapId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /character-photos/{projectId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
