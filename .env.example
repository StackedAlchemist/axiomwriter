# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Anthropic Claude API
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe (frontend - publishable key only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_STRIPE_WRITER_PRICE_ID=price_...
VITE_STRIPE_COMPOSER_PRICE_ID=price_...
VITE_STRIPE_ARCHITECT_PRICE_ID=price_...

# EmailJS (beta feedback emails)
VITE_EMAILJS_SERVICE_ID=service_...
VITE_EMAILJS_TEMPLATE_ID=template_...
VITE_EMAILJS_PUBLIC_KEY=...

# Stability AI (cover image generation)
VITE_STABILITY_API_KEY=sk-...
